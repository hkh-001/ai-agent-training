# 复制为 .env 后再填入真实值；不要提交 .env。
OPENAI_API_KEY=
OPENAI_MODEL=
USE_REAL_MODEL=false

# DeepSeek：请只在本机 .env 中填写新建的密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：开启 LangSmith tracing 时再填写。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-agent-learning-15days
